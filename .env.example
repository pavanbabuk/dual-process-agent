# TypeSafe AI Jev API Key (from https://console.typesafe.ai)
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_BASE_URL=https://api.typesafe.ai

# System 2 Fallback Configuration
# Supported providers: "mock", "hermes_ollama", "grok", "anthropic", "openai"
SYSTEM_TWO_PROVIDER=mock

# For Hermes via local Ollama / vLLM (OpenAI compatible)
HERMES_BASE_URL=http://localhost:11434/v1
HERMES_MODEL=nous-hermes-3-llama-3.1-8b

# For xAI Grok
GROK_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-2-latest

# For Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# For OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Dual Process Confidence Threshold (0.0 to 1.0)
# Above this threshold, Jev dispatches directly without waking System 2.
SYSTEM_ONE_CONFIDENCE_THRESHOLD=0.85

# Telegram gateway (only needed for: dual-agent --gateway)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# REQUIRED for the gateway to accept anything: comma-separated Telegram user ids.
# The bot runs shell commands and writes files, so with this empty it rejects
# every message instead of trusting whoever finds the bot.
TELEGRAM_ALLOWED_USER_IDS=

# The Agent Dashboard (dual-agent --ui) has no authentication and can execute
# tools as you. It binds to 127.0.0.1 only; set this to true ONLY behind your own
# auth proxy if you deliberately want it reachable from the network.
DUAL_AGENT_UI_ALLOW_PUBLIC_BIND=false

# Escape hatch: let the fast path execute a tool whose arguments could not be
# verified against the tool's schema. Off by default because the runtime then
# guesses arguments — e.g. reading a config file for a goal that never named it.
DUAL_AGENT_ALLOW_UNVERIFIED_FAST_PATH=false
